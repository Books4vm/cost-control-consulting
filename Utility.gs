function cccNow_(){return new Date()}function cccClean_(v,n){var s=v==null?"":String(v).replace(/[\u0000-\u001F\u007F]/g,"").trim();return n?s.substring(0,n):s}function cccEmail_(v){return cccClean_(v,254).toLowerCase()}function cccEscapeHtml_(v){return cccClean_(v).replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;").replace(/"/g,"&quot;").replace(/'/g,"&#039;")}function cccDateKey_(d){return Utilities.formatDate(new Date(d),CCC.TIME_ZONE,"yyyyMMdd")}function cccIsoDate_(d){return Utilities.formatDate(new Date(d),CCC.TIME_ZONE,"yyyy-MM-dd")}function cccIsoDateTime_(d){return Utilities.formatDate(new Date(d),CCC.TIME_ZONE,"yyyy-MM-dd'T'HH:mm:ssXXX")}function cccLongDate_(d){return Utilities.formatDate(new Date(d),CCC.TIME_ZONE,"EEEE, MMMM d, yyyy")}function cccTime_(d){return Utilities.formatDate(new Date(d),CCC.TIME_ZONE,"h:mm a")}function cccDateTime_(d){return Utilities.formatDate(new Date(d),CCC.TIME_ZONE,"MM/dd/yyyy h:mm a")}function cccStartOfDay_(d){var x=new Date(d);x.setHours(0,0,0,0);return x}function cccIsWeekend_(d){var n=new Date(d).getDay();return n===0||n===6}function cccAddBusinessDays_(d,n){var x=cccStartOfDay_(d),a=0;while(a<n){x.setDate(x.getDate()+1);if(!cccIsWeekend_(x))a++}return x}function cccDateTimeFromParts_(d,h,m){var x=new Date(d);x.setHours(h,m,0,0);return x}function cccAddMinutes_(d,m){return new Date(new Date(d).getTime()+m*60000)}function cccParseDate_(s){var m=/^(\d{4})-(\d{2})-(\d{2})$/.exec(cccClean_(s,10));if(!m)throw new Error("A valid date is required.");var d=new Date(+m[1],+m[2]-1,+m[3]);d.setHours(0,0,0,0);return d}function cccParseDateTime_(s){var d=new Date(cccClean_(s,60));if(isNaN(d.getTime()))throw new Error("A valid appointment time is required.");return d}function cccGenerateId_(p){return p+"-"+Utilities.formatDate(cccNow_(),CCC.TIME_ZONE,"yyyyMMddHHmmss")+"-"+Math.floor(1000+Math.random()*9000)}function cccResult_(ok,data,msg){return{success:!!ok,data:data||null,message:msg||""}}
