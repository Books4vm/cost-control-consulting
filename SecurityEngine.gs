function createSchedulerSession(v){v=cccClean_(v,120)||Utilities.getUuid();cccRateLimit_("session:"+v);var t=Utilities.getUuid();CacheService.getScriptCache().put("session:"+t,JSON.stringify({visitorId:v,createdAt:cccNow_().toISOString()}),CCC.SESSION_TTL_SECONDS);return cccResult_(true,{sessionToken:t,visitorId:v},"")}function cccValidateSession_(t,v){t=cccClean_(t,120);v=cccClean_(v,120);if(!t||!v)throw new Error("Your scheduling session is not valid. Please reopen the form.");var r=CacheService.getScriptCache().get("session:"+t);if(!r)throw new Error("Your scheduling session has expired. Please reopen the form.");if(JSON.parse(r).visitorId!==v)throw new Error("Your scheduling session could not be verified.")}function cccRateLimit_(k){var c=CacheService.getScriptCache(),q="rate:"+cccClean_(k,160),n=Number(c.get(q)||0);if(n>=CCC.RATE_MAX)throw new Error("Too many requests were received. Please wait and try again.");c.put(q,String(n+1),CCC.RATE_WINDOW_SECONDS)}function cccClaimSubmission_(t){t=cccClean_(t,120);if(!t)throw new Error("A submission token is required.");var c=CacheService.getScriptCache(),k="submission:"+t;if(c.get(k))throw new Error("This appointment request has already been processed.");c.put(k,"PROCESSING",CCC.SESSION_TTL_SECONDS);return k}function cccCompleteSubmission_(k,id){CacheService.getScriptCache().put(k,"COMPLETE:"+id,CCC.SESSION_TTL_SECONDS)}function cccReleaseSubmission_(k){if(k)CacheService.getScriptCache().remove(k)}
