function cccCalendar_(){var c=CalendarApp.getCalendarsByName(CCC.CALENDAR_NAME);if(!c.length)throw new Error("Calendar not found: "+CCC.CALENDAR_NAME);if(c.length>1)throw new Error("More than one calendar has the same name.");return c[0]}function testCCCConnections(){var s=cccSpreadsheet_(),c=cccCalendar_(),r={spreadsheetName:s.getName(),spreadsheetId:s.getId(),spreadsheetTimeZone:s.getSpreadsheetTimeZone(),calendarName:c.getName(),calendarId:c.getId(),calendarTimeZone:c.getTimeZone(),effectiveUser:Session.getEffectiveUser().getEmail()};console.log(JSON.stringify(r,null,2));return r}function cccEventsForDate_(d){var a=cccStartOfDay_(d),b=new Date(a);b.setDate(b.getDate()+1);return cccCalendar_().getEvents(a,b)}function cccSlotAvailable_(a,b){var z=CCC.BUFFER_MINUTES*60000;return !cccEventsForDate_(a).some(function(e){if(e.isAllDayEvent())return true;var x=e.getStartTime().getTime()-z,y=e.getEndTime().getTime()+z;return a.getTime()<y&&b.getTime()>x})}function cccCreateEvent_(b,id){var desc=["Reference Number: "+id,"Company: "+b.companyName,"Contact: "+b.firstName+" "+b.lastName,"Email: "+b.email,"Phone: "+(b.phone||""),"Industry: "+(b.industry||""),"Employees: "+(b.employeeRange||""),"Annual Revenue: "+(b.annualRevenueRange||""),"Primary Service: "+b.primaryAreaOfInterest,"Business Challenges: "+b.businessChallenges.join(", "),"","Business Challenge Description:",b.businessChallengeDescription,"","Desired Outcome:",b.desiredOutcome].join("\n");var e=cccCalendar_().createEvent("CCC Consultation - "+b.companyName,b.slotStart,b.slotEnd,{description:desc,guests:b.email,sendInvites:true});return{event:e,eventId:e.getId(),eventUrl:""}}
