function cccSendInternalEmail_(b,i){GmailApp.sendEmail(CCC.OWNER_EMAIL,"NEW CONSULTATION REQUEST - "+i.appointmentId,"New consultation: "+i.appointmentId,{htmlBody:cccBuildInternalEmail_(b,i),name:"Cost Control Consulting",replyTo:b.email})}function cccSendClientEmail_(b,i){GmailApp.sendEmail(b.email,"Your CCC consultation is confirmed - "+i.appointmentId,"Confirmed: "+i.appointmentId,{htmlBody:cccBuildClientEmail_(b,i),name:"Cost Control Consulting",replyTo:CCC.OWNER_EMAIL})}function cccEmailShell_(t,b){return'<div style="margin:0;padding:24px;background:#eef7fd;font-family:Arial;color:#17324d"><div style="max-width:720px;margin:auto;background:#fff;border-radius:14px;overflow:hidden;border:1px solid #cfe5f5"><div style="background:#9fd3f4;padding:24px 30px;border-bottom:5px solid #1f5d8f"><div style="font-size:27px;font-weight:700;color:#123f60">Cost Control Consulting</div><div>Clarity. Confidence. Compliance.</div></div><div style="padding:30px"><h1 style="color:#123f60">'+cccEscapeHtml_(t)+'</h1>'+b+'</div><div style="padding:18px 30px;background:#123f60;color:#fff">Cost Control Consulting</div></div></div>'}function cccBuildInternalEmail_(b,i){var r=[["Reference",i.appointmentId],["Company",b.companyName],["Contact",b.firstName+" "+b.lastName],["Email",b.email],["Phone",b.phone],["Industry",b.industry],["Service",b.primaryAreaOfInterest],["Challenges",b.businessChallenges.join(", ")],["Appointment",cccLongDate_(b.slotStart)+", "+cccTime_(b.slotStart)+" - "+cccTime_(b.slotEnd)+" Pacific Time"]],table=r.map(function(x){return'<tr><td style="padding:10px;font-weight:700;border-bottom:1px solid #ddd">'+cccEscapeHtml_(x[0])+'</td><td style="padding:10px;border-bottom:1px solid #ddd">'+cccEscapeHtml_(x[1]||"")+'</td></tr>'}).join("");return cccEmailShell_("New Consultation: "+i.appointmentId,'<table style="width:100%;border-collapse:collapse">'+table+'</table><h2>Business Challenge</h2><div style="white-space:pre-wrap">'+cccEscapeHtml_(b.businessChallengeDescription)+'</div><h2>Desired Outcome</h2><div style="white-space:pre-wrap">'+cccEscapeHtml_(b.desiredOutcome)+'</div>')}function cccBuildClientEmail_(b,i){return cccEmailShell_("Your Consultation Is Confirmed",'<p>Dear '+cccEscapeHtml_(b.firstName)+',</p><p>Thank you for contacting Cost Control Consulting.</p><div style="padding:22px;background:#eaf6fd;border-radius:10px"><strong style="font-size:24px">'+cccEscapeHtml_(i.appointmentId)+'</strong><br><br>'+cccEscapeHtml_(cccLongDate_(b.slotStart))+'<br>'+cccEscapeHtml_(cccTime_(b.slotStart))+' - '+cccEscapeHtml_(cccTime_(b.slotEnd))+' Pacific Time</div><p>We will review your information before the meeting so the consultation can be focused and productive.</p>')}
